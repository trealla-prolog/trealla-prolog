---
// A program pane, a query box and an output pane, running Trealla compiled to WebAssembly in a worker.
import examples from '../repl/examples.json';

interface Props {
	id?: string;
	tall?: boolean;
	share?: boolean;
}
const { id, tall = false, share = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const first = examples[0];
---

<section
	class:list={['tr-repl', 'not-content', { tall }]}
	id={id}
	data-wasm={`${base}tpl.wasm`}
	data-share={share ? '' : undefined}
	aria-label="Trealla Prolog in the browser"
>
	<div class="tr-bar">
		<div class="tr-examples" role="group" aria-label="Examples">
			{
				examples.map((ex, i) => (
					<button type="button" data-example={ex.id} aria-pressed={i === 0 ? 'true' : 'false'}>
						{ex.label}
					</button>
				))
			}
		</div>
		<span class="tr-version" aria-live="polite"></span>
	</div>
	<div class="tr-body">
		<div class="tr-pane">
			<label class="tr-label" for={id ? `${id}-program` : undefined}>program.pl</label>
			<div class="tr-editor">
				<pre class="tr-hl" aria-hidden="true"></pre>
				<textarea class="tr-program" id={id ? `${id}-program` : undefined} spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby={id ? `${id}-keys` : undefined}>{first.program}</textarea>
			</div>
			<span class="sr-only" id={id ? `${id}-keys` : undefined}>Tab indents. Press Escape and then Tab to leave the program.</span>
		</div>
		<div class="tr-pane">
			<div class="tr-query-row">
				<span class="tr-prompt" aria-hidden="true">?-</span>
				<textarea class="tr-query" rows="1" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Query">{first.query}</textarea>
				<button type="button" class="tr-run">Run</button>
			</div>
			<pre class="tr-output" aria-live="polite" tabindex="0"></pre>
			<div class="tr-foot">
				<span class="tr-status">Press Run or Enter. Shift+Enter starts another query line; Ctrl+Enter runs from the program pane.</span>
				{share && <button type="button" class="tr-share">Copy link</button>}
			</div>
		</div>
	</div>
	<script type="application/json" class="tr-data" set:html={JSON.stringify(examples)} />
</section>

<style>
	.tr-repl {
		--tr-mono: var(--__sl-font-mono);
		border: 1px solid var(--tr-panel-border);
		border-radius: 0.75rem;
		background: var(--tr-panel);
		overflow: hidden;
		text-align: start;
		box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.45);
	}
	.tr-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var(--tr-panel-border);
	}
	.tr-examples {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.tr-examples button,
	.tr-run,
	.tr-share {
		font: inherit;
		font-size: var(--sl-text-sm);
		border-radius: 999px;
		cursor: pointer;
	}
	.tr-examples button {
		padding: 0.2rem 0.75rem;
		border: 1px solid var(--tr-panel-border);
		background: transparent;
		color: var(--sl-color-gray-2);
	}
	.tr-examples button:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	.tr-examples button[aria-pressed='true'] {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.tr-version {
		font-family: var(--tr-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tr-body {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 50rem) {
		.tr-body {
			grid-template-columns: 1fr 1fr;
		}
		.tr-pane + .tr-pane {
			border-inline-start: 1px solid var(--tr-panel-border);
		}
	}
	.tr-pane {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.tr-label {
		padding: 0.5rem 0.9rem 0;
		font-family: var(--tr-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tr-program,
	.tr-output,
	.tr-query {
		font-family: var(--tr-mono);
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--sl-color-white);
		tab-size: 4;
	}
	/* The program is a textarea over a highlighted copy of its text: the textarea keeps the
	   caret and selection but draws its text transparent, and the copy scrolls with it. */
	.tr-editor {
		position: relative;
		flex: 1;
		display: flex;
	}
	.tr-program,
	.tr-hl {
		margin: 0;
		padding: 0.5rem 0.9rem 0.9rem;
		border: 0;
		font-variant-ligatures: none;
		white-space: pre;
	}
	.tr-program {
		position: relative;
		flex: 1;
		width: 100%;
		min-height: 15rem;
		resize: vertical;
		background: transparent;
		color: transparent;
		caret-color: var(--sl-color-white);
		outline: none;
		overflow: auto;
	}
	.tr-program::selection {
		background: var(--sl-color-accent-low);
		color: transparent;
	}
	.tr-hl {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		background: transparent;
		font-family: var(--tr-mono);
		font-size: 0.85rem;
		line-height: 1.55;
		tab-size: 4;
		color: var(--sl-color-white);
	}
	.tr-hl :global(.c) {
		color: var(--sl-color-gray-3);
		font-style: italic;
	}
	.tr-hl :global(.s) {
		color: var(--tr-ochre);
	}
	.tr-hl :global(.v) {
		color: var(--sl-color-text-accent);
	}
	.tr-hl :global(.n) {
		color: var(--tr-blue);
	}
	.tr-hl :global(.k) {
		color: var(--sl-color-gray-2);
		font-weight: 700;
	}
	.tr-hl :global(.m) {
		border-radius: 2px;
		background: var(--sl-color-accent-low);
		box-shadow: 0 0 0 1px var(--sl-color-accent);
	}
	.tr-hl :global(.x) {
		border-radius: 2px;
		background: color-mix(in srgb, var(--tr-ochre) 30%, transparent);
	}
	.tall .tr-program {
		min-height: 26rem;
	}
	@media (max-width: 50rem) {
		.tr-program,
		.tall .tr-program {
			min-height: 10rem;
		}
		.tr-output,
		.tall .tr-output {
			min-height: 8rem;
		}
	}
	.tr-program:focus-visible,
	.tr-query:focus-visible,
	.tr-output:focus-visible {
		box-shadow: inset 0 0 0 2px var(--sl-color-accent);
	}
	.tr-query-row {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--tr-panel-border);
	}
	.tr-prompt {
		padding-top: 0.35rem;
		font-family: var(--tr-mono);
		font-weight: 700;
		color: var(--sl-color-text-accent);
	}
	.tr-query {
		flex: 1;
		min-width: 0;
		padding: 0.35rem 0.5rem;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		background: var(--sl-color-black);
		outline: none;
		max-height: 9.5rem;
		resize: none;
		overflow-y: auto;
		white-space: pre-wrap;
	}
	.tr-run {
		padding: 0.35rem 1.1rem;
		border: 0;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.tr-run:hover {
		filter: brightness(1.1);
	}
	.tr-run[data-running] {
		background: var(--tr-ochre);
	}
	.tr-output {
		flex: 1;
		min-height: 12rem;
		max-height: 24rem;
		margin: 0;
		padding: 0.75rem 0.9rem;
		overflow: auto;
		white-space: pre-wrap;
		word-break: break-word;
		background: transparent;
		border: 0;
		border-radius: 0;
		outline: none;
	}
	.tall .tr-output {
		max-height: none;
		min-height: 22rem;
	}
	.tr-output :global(.q) {
		color: var(--sl-color-text-accent);
	}
	.tr-output :global(.err) {
		color: var(--tr-ochre);
	}
	.tr-output :global(.note) {
		color: var(--sl-color-gray-3);
		font-style: italic;
	}
	.tr-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.45rem 0.9rem;
		border-top: 1px solid var(--tr-panel-border);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tr-share {
		padding: 0.15rem 0.7rem;
		border: 1px solid var(--tr-panel-border);
		background: transparent;
		color: var(--sl-color-gray-2);
	}
</style>

<script>
	type Example = { id: string; label: string; program: string; query: string };

	const TIMEOUT_MS = 10_000;
	let modulePromise: Promise<WebAssembly.Module> | undefined;
	let versionPromise: Promise<string> | undefined;

	function loadModule(url: string) {
		modulePromise ??= (async () => {
			const res = await fetch(url);
			if (!res.ok) throw new Error(`could not fetch tpl.wasm (${res.status})`);
			try {
				return await WebAssembly.compileStreaming(res.clone());
			} catch {
				return WebAssembly.compile(await res.arrayBuffer());
			}
		})();
		modulePromise.catch(() => (modulePromise = undefined));
		return modulePromise;
	}

	function newWorker() {
		return new Worker(new URL('../repl/tpl-worker.ts', import.meta.url), { type: 'module' });
	}

	function version(module: WebAssembly.Module) {
		versionPromise ??= new Promise((resolve) => {
			const w = newWorker();
			let out = '';
			w.onmessage = (e) => {
				if (e.data.type === 'out') out += e.data.text;
				if (e.data.type === 'done' || e.data.type === 'crash') {
					w.terminate();
					resolve(out.match(/v\d+\.\d+\.\d+\S*/)?.[0] ?? '');
				}
			};
			w.postMessage({ module, args: ['tpl', '-v'] });
		});
		return versionPromise;
	}

	function encodeShare(program: string, query: string) {
		const bytes = new TextEncoder().encode(JSON.stringify({ p: program, q: query }));
		let bin = '';
		bytes.forEach((b) => (bin += String.fromCharCode(b)));
		return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
	}

	function decodeShare(s: string): { p: string; q: string } | undefined {
		try {
			const bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
			const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
			const v = JSON.parse(new TextDecoder().decode(bytes));
			return typeof v.p === 'string' && typeof v.q === 'string' ? v : undefined;
		} catch {
			return undefined;
		}
	}

	// Prolog tokens worth colouring, tried in order at each position: comments, quoted text,
	// numbers, variables, then atoms (left plain, but consumed so their insides aren't read
	// as variables or numbers) and the punctuation that shapes a clause.
	const RULES: [RegExp, string][] = [
		[/%[^\n]*/y, 'c'],
		[/\/\*[\s\S]*?(?:\*\/|$)/y, 'c'],
		[/0'(?:\\.|''|[^\\\n])/y, 'n'],
		[/"(?:\\[\s\S]|""|[^"\\])*"?/y, 's'],
		[/'(?:\\[\s\S]|''|[^'\\])*'?/y, 's'],
		[/`(?:\\[\s\S]|``|[^`\\])*`?/y, 's'],
		[/0x[0-9a-fA-F]+|0o[0-7]+|0b[01]+|\d+(?:\.\d+(?:[eE][+-]?\d+)?)?(?:r\d+)?/y, 'n'],
		[/[A-Z_][A-Za-z0-9_]*/y, 'v'],
		[/[a-z][A-Za-z0-9_]*/y, ''],
		[/:-|-->|\?-|->|!|;|\|/y, 'k'],
	];

	// A class for each character of text: '' for plain.
	function classify(text: string) {
		const cls: string[] = new Array(text.length).fill('');
		for (let i = 0; i < text.length; ) {
			let n = 0;
			for (const [re, c] of RULES) {
				re.lastIndex = i;
				const m = re.exec(text);
				if (m && m[0]) {
					n = m[0].length;
					if (c) cls.fill(c, i, i + n);
					break;
				}
			}
			i += n || 1;
		}
		return cls;
	}

	const OPEN = '([{';
	const CLOSE = ')]}';

	// The bracket next to the caret, the one before it first, and its partner: 'm' for a pair,
	// 'x' for one with no partner. Brackets in comments and quoted text don't count.
	function brackets(text: string, cls: string[], caret: number): Map<number, string> {
		for (const at of [caret - 1, caret]) {
			if (at < 0 || at >= text.length || cls[at]) continue;
			const o = OPEN.indexOf(text[at]);
			const c = CLOSE.indexOf(text[at]);
			if (o < 0 && c < 0) continue;
			const [open, close, step] = o >= 0 ? [OPEN[o], CLOSE[o], 1] : [OPEN[c], CLOSE[c], -1];
			let depth = 0;
			for (let j = at; j >= 0 && j < text.length; j += step) {
				if (cls[j]) continue;
				if (text[j] === (step > 0 ? open : close)) depth++;
				else if (text[j] === (step > 0 ? close : open) && --depth === 0) return new Map([[at, 'm'], [j, 'm']]);
			}
			return new Map([[at, 'x']]);
		}
		return new Map();
	}

	const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

	function highlight(text: string, cls: string[], marks: Map<number, string>) {
		let html = '';
		for (let i = 0; i < text.length; ) {
			const c = [cls[i], marks.get(i) ?? ''].join(' ').trim();
			let j = i + 1;
			while (j < text.length && !marks.has(j) && !marks.has(j - 1) && cls[j] === cls[i]) j++;
			html += c ? `<span class="${c}">${escape(text.slice(i, j))}</span>` : escape(text.slice(i, j));
			i = j;
		}
		// A trailing newline needs something after it, or the copy is a line short of the textarea.
		return html + (text.endsWith('\n') ? ' ' : '');
	}

	function setup(root: HTMLElement) {
		const examples: Example[] = JSON.parse(root.querySelector('.tr-data')!.textContent!);
		const program = root.querySelector<HTMLTextAreaElement>('.tr-program')!;
		const hl = root.querySelector<HTMLPreElement>('.tr-hl')!;
		const query = root.querySelector<HTMLTextAreaElement>('.tr-query')!;
		const output = root.querySelector<HTMLPreElement>('.tr-output')!;
		const status = root.querySelector<HTMLElement>('.tr-status')!;
		const run = root.querySelector<HTMLButtonElement>('.tr-run')!;
		const ver = root.querySelector<HTMLElement>('.tr-version')!;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-example]')];
		const shareBtn = root.querySelector<HTMLButtonElement>('.tr-share');
		const wasmUrl = root.dataset.wasm!;

		let worker: Worker | undefined;
		let timer: ReturnType<typeof setTimeout> | undefined;
		let running = false;

		const append = (text: string, cls?: string) => {
			const span = document.createElement('span');
			if (cls) span.className = cls;
			span.textContent = text;
			output.append(span);
			output.scrollTop = output.scrollHeight;
		};

		const warm = () =>
			loadModule(wasmUrl)
				.then((m) => version(m))
				.then((v) => (ver.textContent = v ? `Trealla ${v} · WebAssembly` : 'WebAssembly'))
				.catch(() => {});

		const finish = (msg: string) => {
			running = false;
			clearTimeout(timer);
			run.textContent = 'Run';
			delete run.dataset.running;
			status.textContent = msg;
		};

		const stop = (msg: string) => {
			worker?.terminate();
			worker = undefined;
			append(`\n${msg}\n`, 'note');
			finish(msg);
		};

		async function go() {
			if (running) return stop('Stopped.');
			let q = query.value.trim();
			if (!q) return query.focus();
			if (!q.endsWith('.')) q += '.';
			output.textContent = '';
			running = true;
			run.textContent = 'Stop';
			run.dataset.running = '';
			status.textContent = modulePromise ? 'Running…' : 'Loading Trealla (about 2.6 MB, once)…';
			let module: WebAssembly.Module;
			try {
				module = await loadModule(wasmUrl);
			} catch (err) {
				append(`${err}\n`, 'err');
				return finish('Could not load Trealla.');
			}
			if (!running) return;
			warm();
			status.textContent = 'Running…';
			worker ??= newWorker();
			worker.onmessage = (e) => {
				const d = e.data;
				if (d.type === 'out') append(d.text);
				else if (d.type === 'q') append(d.text, 'q');
				else if (d.type === 'err') append(d.text, 'err');
				else if (d.type === 'done') finish(`Done in ${Math.round(d.ms)} ms.`);
				else if (d.type === 'crash') {
					const text = /call stack|recursion/i.test(d.text) ? 'Out of stack: the browser allows far less than a native tpl.' : d.text;
					append(`\n${text}\n`, 'err');
					worker?.terminate();
					worker = undefined;
					finish('Crashed.');
				}
			};
			worker.onerror = (e) => {
				append(`\n${e.message}\n`, 'err');
				worker = undefined;
				finish('Crashed.');
			};
			worker.postMessage({ module, program: program.value, query: q + '\n' });
			timer = setTimeout(() => stop(`Stopped after ${TIMEOUT_MS / 1000} s.`), TIMEOUT_MS);
		}

		const render = () => {
			const text = program.value;
			const cls = classify(text);
			const marks = document.activeElement === program && program.selectionStart === program.selectionEnd
				? brackets(text, cls, program.selectionStart)
				: new Map<number, string>();
			hl.innerHTML = highlight(text, cls, marks);
			hl.scrollTop = program.scrollTop;
			hl.scrollLeft = program.scrollLeft;
		};

		// Tab indents, or with Shift outdents, the line or the selected lines. Escape then Tab
		// leaves the pane the usual way, so the keyboard never gets stuck in it.
		const indent = (out: boolean) => {
			const { value, selectionStart: from, selectionEnd: to } = program;
			const edit = (text: string, start: number, end: number) => {
				program.setSelectionRange(start, end);
				// insertText keeps the browser's undo history; setRangeText is the fallback.
				if (!document.execCommand('insertText', false, text)) {
					program.setRangeText(text, start, end, 'end');
					program.dispatchEvent(new Event('input'));
				}
			};
			if (!out && !value.slice(from, to).includes('\n')) return edit('\t', from, to);
			const start = value.lastIndexOf('\n', from - 1) + 1;
			const lines = value.slice(start, to).split('\n');
			const last = lines.length - 1;
			const changed = lines
				.map((l, i) => (i === last && i > 0 && l === '' ? l : out ? l.replace(/^(\t| {1,4})/, '') : '\t' + l))
				.join('\n');
			edit(changed, start, to);
			if (from === to) {
				const caret = Math.max(start, from + changed.length - (to - start));
				program.setSelectionRange(caret, caret);
			} else program.setSelectionRange(start, start + changed.length);
		};

		let leaving = false;
		program.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				leaving = true;
				return;
			}
			const tab = e.key === 'Tab' && !e.ctrlKey && !e.metaKey && !e.altKey;
			if (tab && !leaving) {
				e.preventDefault();
				indent(e.shiftKey);
			}
			leaving = false;
		});
		program.addEventListener('input', render);
		program.addEventListener('scroll', () => {
			hl.scrollTop = program.scrollTop;
			hl.scrollLeft = program.scrollLeft;
		});
		program.addEventListener('blur', render);
		document.addEventListener('selectionchange', () => {
			if (document.activeElement === program) render();
		});

		// The query box grows with its lines.
		const fit = () => {
			query.style.height = 'auto';
			query.style.height = `${query.scrollHeight}px`;
		};

		const choose = (ex: Example) => {
			program.value = ex.program;
			query.value = ex.query;
			render();
			fit();
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.example === ex.id)));
			output.textContent = '';
		};

		buttons.forEach((b) =>
			b.addEventListener('click', () => {
				const ex = examples.find((x) => x.id === b.dataset.example);
				if (ex) choose(ex);
				go();
			}),
		);
		const unpress = () => buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
		program.addEventListener('input', unpress);
		query.addEventListener('input', unpress);
		query.addEventListener('input', fit);
		run.addEventListener('click', go);
		query.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && !e.shiftKey) {
				e.preventDefault();
				go();
			}
		});
		program.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
				e.preventDefault();
				go();
			}
		});

		if (root.dataset.share !== undefined) {
			// #code=... loads a shared program and query; a trailing &run (from the docs) runs it too.
			const m = location.hash.match(/^#code=([^&]+)(&run)?$/);
			const shared = m && decodeShare(m[1]);
			if (shared) {
				program.value = shared.p;
				query.value = shared.q;
				render();
				unpress();
				if (m && m[2]) go();
			}
			shareBtn?.addEventListener('click', async () => {
				const url = `${location.origin}${location.pathname}#code=${encodeShare(program.value, query.value)}`;
				history.replaceState(null, '', url);
				try {
					await navigator.clipboard.writeText(url);
					status.textContent = 'Link copied.';
				} catch {
					status.textContent = 'Link is in the address bar.';
				}
			});
		}

		// Fetch and compile once the REPL comes into view, so Run is instant.
		new IntersectionObserver((entries, obs) => {
			if (entries.some((e) => e.isIntersecting)) {
				obs.disconnect();
				warm();
			}
		}).observe(root);
		render();
		fit();
	}

	document.querySelectorAll<HTMLElement>('.tr-repl').forEach(setup);
</script>
