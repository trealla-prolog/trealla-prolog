---
// A program pane, a query line and an output pane, running Trealla compiled to WebAssembly in a worker.
import examples from '../repl/examples.json';

interface Props {
	id?: string;
	tall?: boolean;
	share?: boolean;
}
const { id, tall = false, share = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const first = examples[0];
---

<section
	class:list={['tr-repl', 'not-content', { tall }]}
	id={id}
	data-wasm={`${base}tpl.wasm`}
	data-share={share ? '' : undefined}
	aria-label="Trealla Prolog in the browser"
>
	<div class="tr-bar">
		<div class="tr-examples" role="group" aria-label="Examples">
			{
				examples.map((ex, i) => (
					<button type="button" data-example={ex.id} aria-pressed={i === 0 ? 'true' : 'false'}>
						{ex.label}
					</button>
				))
			}
		</div>
		<span class="tr-version" aria-live="polite"></span>
	</div>
	<div class="tr-body">
		<div class="tr-pane">
			<label class="tr-label" for={id ? `${id}-program` : undefined}>program.pl</label>
			<textarea class="tr-program" id={id ? `${id}-program` : undefined} spellcheck="false" autocapitalize="off" autocomplete="off">{first.program}</textarea>
		</div>
		<div class="tr-pane">
			<div class="tr-query-row">
				<span class="tr-prompt" aria-hidden="true">?-</span>
				<input class="tr-query" type="text" value={first.query} spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Query" />
				<button type="button" class="tr-run">Run</button>
			</div>
			<pre class="tr-output" aria-live="polite" tabindex="0"></pre>
			<div class="tr-foot">
				<span class="tr-status">Press Run or Enter. Ctrl+Enter runs from the program pane.</span>
				{share && <button type="button" class="tr-share">Copy link</button>}
			</div>
		</div>
	</div>
	<script type="application/json" class="tr-data" set:html={JSON.stringify(examples)} />
</section>

<style>
	.tr-repl {
		--tr-mono: var(--__sl-font-mono);
		border: 1px solid var(--tr-panel-border);
		border-radius: 0.75rem;
		background: var(--tr-panel);
		overflow: hidden;
		text-align: start;
		box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.45);
	}
	.tr-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var(--tr-panel-border);
	}
	.tr-examples {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.tr-examples button,
	.tr-run,
	.tr-share {
		font: inherit;
		font-size: var(--sl-text-sm);
		border-radius: 999px;
		cursor: pointer;
	}
	.tr-examples button {
		padding: 0.2rem 0.75rem;
		border: 1px solid var(--tr-panel-border);
		background: transparent;
		color: var(--sl-color-gray-2);
	}
	.tr-examples button:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	.tr-examples button[aria-pressed='true'] {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.tr-version {
		font-family: var(--tr-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tr-body {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 50rem) {
		.tr-body {
			grid-template-columns: 1fr 1fr;
		}
		.tr-pane + .tr-pane {
			border-inline-start: 1px solid var(--tr-panel-border);
		}
	}
	.tr-pane {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.tr-label {
		padding: 0.5rem 0.9rem 0;
		font-family: var(--tr-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tr-program,
	.tr-output,
	.tr-query {
		font-family: var(--tr-mono);
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--sl-color-white);
		tab-size: 4;
	}
	.tr-program {
		flex: 1;
		min-height: 15rem;
		resize: vertical;
		padding: 0.5rem 0.9rem 0.9rem;
		border: 0;
		background: transparent;
		outline: none;
		white-space: pre;
		overflow: auto;
	}
	.tall .tr-program {
		min-height: 26rem;
	}
	@media (max-width: 50rem) {
		.tr-program,
		.tall .tr-program {
			min-height: 10rem;
		}
		.tr-output,
		.tall .tr-output {
			min-height: 8rem;
		}
	}
	.tr-program:focus-visible,
	.tr-query:focus-visible,
	.tr-output:focus-visible {
		box-shadow: inset 0 0 0 2px var(--sl-color-accent);
	}
	.tr-query-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--tr-panel-border);
	}
	.tr-prompt {
		font-family: var(--tr-mono);
		font-weight: 700;
		color: var(--sl-color-text-accent);
	}
	.tr-query {
		flex: 1;
		min-width: 0;
		padding: 0.35rem 0.5rem;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		background: var(--sl-color-black);
		outline: none;
	}
	.tr-run {
		padding: 0.35rem 1.1rem;
		border: 0;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.tr-run:hover {
		filter: brightness(1.1);
	}
	.tr-run[data-running] {
		background: var(--tr-ochre);
	}
	.tr-output {
		flex: 1;
		min-height: 12rem;
		max-height: 24rem;
		margin: 0;
		padding: 0.75rem 0.9rem;
		overflow: auto;
		white-space: pre-wrap;
		word-break: break-word;
		background: transparent;
		border: 0;
		border-radius: 0;
		outline: none;
	}
	.tall .tr-output {
		max-height: none;
		min-height: 22rem;
	}
	.tr-output :global(.q) {
		color: var(--sl-color-text-accent);
	}
	.tr-output :global(.err) {
		color: var(--tr-ochre);
	}
	.tr-output :global(.note) {
		color: var(--sl-color-gray-3);
		font-style: italic;
	}
	.tr-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.45rem 0.9rem;
		border-top: 1px solid var(--tr-panel-border);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tr-share {
		padding: 0.15rem 0.7rem;
		border: 1px solid var(--tr-panel-border);
		background: transparent;
		color: var(--sl-color-gray-2);
	}
</style>

<script>
	type Example = { id: string; label: string; program: string; query: string };

	const TIMEOUT_MS = 10_000;
	let modulePromise: Promise<WebAssembly.Module> | undefined;
	let versionPromise: Promise<string> | undefined;

	function loadModule(url: string) {
		modulePromise ??= (async () => {
			const res = await fetch(url);
			if (!res.ok) throw new Error(`could not fetch tpl.wasm (${res.status})`);
			try {
				return await WebAssembly.compileStreaming(res.clone());
			} catch {
				return WebAssembly.compile(await res.arrayBuffer());
			}
		})();
		modulePromise.catch(() => (modulePromise = undefined));
		return modulePromise;
	}

	function newWorker() {
		return new Worker(new URL('../repl/tpl-worker.ts', import.meta.url), { type: 'module' });
	}

	function version(module: WebAssembly.Module) {
		versionPromise ??= new Promise((resolve) => {
			const w = newWorker();
			let out = '';
			w.onmessage = (e) => {
				if (e.data.type === 'out') out += e.data.text;
				if (e.data.type === 'done' || e.data.type === 'crash') {
					w.terminate();
					resolve(out.match(/v\d+\.\d+\.\d+\S*/)?.[0] ?? '');
				}
			};
			w.postMessage({ module, args: ['tpl', '-v'] });
		});
		return versionPromise;
	}

	function encodeShare(program: string, query: string) {
		const bytes = new TextEncoder().encode(JSON.stringify({ p: program, q: query }));
		let bin = '';
		bytes.forEach((b) => (bin += String.fromCharCode(b)));
		return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
	}

	function decodeShare(s: string): { p: string; q: string } | undefined {
		try {
			const bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
			const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
			const v = JSON.parse(new TextDecoder().decode(bytes));
			return typeof v.p === 'string' && typeof v.q === 'string' ? v : undefined;
		} catch {
			return undefined;
		}
	}

	function setup(root: HTMLElement) {
		const examples: Example[] = JSON.parse(root.querySelector('.tr-data')!.textContent!);
		const program = root.querySelector<HTMLTextAreaElement>('.tr-program')!;
		const query = root.querySelector<HTMLInputElement>('.tr-query')!;
		const output = root.querySelector<HTMLPreElement>('.tr-output')!;
		const status = root.querySelector<HTMLElement>('.tr-status')!;
		const run = root.querySelector<HTMLButtonElement>('.tr-run')!;
		const ver = root.querySelector<HTMLElement>('.tr-version')!;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-example]')];
		const shareBtn = root.querySelector<HTMLButtonElement>('.tr-share');
		const wasmUrl = root.dataset.wasm!;

		let worker: Worker | undefined;
		let timer: ReturnType<typeof setTimeout> | undefined;
		let running = false;

		const append = (text: string, cls?: string) => {
			const span = document.createElement('span');
			if (cls) span.className = cls;
			span.textContent = text;
			output.append(span);
			output.scrollTop = output.scrollHeight;
		};

		const warm = () =>
			loadModule(wasmUrl)
				.then((m) => version(m))
				.then((v) => (ver.textContent = v ? `Trealla ${v} · WebAssembly` : 'WebAssembly'))
				.catch(() => {});

		const finish = (msg: string) => {
			running = false;
			clearTimeout(timer);
			run.textContent = 'Run';
			delete run.dataset.running;
			status.textContent = msg;
		};

		const stop = (msg: string) => {
			worker?.terminate();
			worker = undefined;
			append(`\n${msg}\n`, 'note');
			finish(msg);
		};

		async function go() {
			if (running) return stop('Stopped.');
			let q = query.value.trim();
			if (!q) return query.focus();
			if (!q.endsWith('.')) q += '.';
			output.textContent = '';
			append(`?- ${q}\n`, 'q');
			running = true;
			run.textContent = 'Stop';
			run.dataset.running = '';
			status.textContent = modulePromise ? 'Running…' : 'Loading Trealla (about 2.6 MB, once)…';
			let module: WebAssembly.Module;
			try {
				module = await loadModule(wasmUrl);
			} catch (err) {
				append(`${err}\n`, 'err');
				return finish('Could not load Trealla.');
			}
			if (!running) return;
			warm();
			status.textContent = 'Running…';
			worker ??= newWorker();
			worker.onmessage = (e) => {
				const d = e.data;
				if (d.type === 'out') append(d.text);
				else if (d.type === 'err') append(d.text, 'err');
				else if (d.type === 'done') finish(`Done in ${Math.round(d.ms)} ms.`);
				else if (d.type === 'crash') {
					const text = /call stack|recursion/i.test(d.text) ? 'Out of stack: the browser allows far less than a native tpl.' : d.text;
					append(`\n${text}\n`, 'err');
					worker?.terminate();
					worker = undefined;
					finish('Crashed.');
				}
			};
			worker.onerror = (e) => {
				append(`\n${e.message}\n`, 'err');
				worker = undefined;
				finish('Crashed.');
			};
			worker.postMessage({ module, program: program.value, query: q + '\n' });
			timer = setTimeout(() => stop(`Stopped after ${TIMEOUT_MS / 1000} s.`), TIMEOUT_MS);
		}

		const choose = (ex: Example) => {
			program.value = ex.program;
			query.value = ex.query;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.example === ex.id)));
			output.textContent = '';
		};

		buttons.forEach((b) =>
			b.addEventListener('click', () => {
				const ex = examples.find((x) => x.id === b.dataset.example);
				if (ex) choose(ex);
				go();
			}),
		);
		const unpress = () => buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
		program.addEventListener('input', unpress);
		query.addEventListener('input', unpress);
		run.addEventListener('click', go);
		query.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				e.preventDefault();
				go();
			}
		});
		program.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
				e.preventDefault();
				go();
			}
		});

		if (root.dataset.share !== undefined) {
			const m = location.hash.match(/^#code=(.+)$/);
			const shared = m && decodeShare(m[1]);
			if (shared) {
				program.value = shared.p;
				query.value = shared.q;
				unpress();
			}
			shareBtn?.addEventListener('click', async () => {
				const url = `${location.origin}${location.pathname}#code=${encodeShare(program.value, query.value)}`;
				history.replaceState(null, '', url);
				try {
					await navigator.clipboard.writeText(url);
					status.textContent = 'Link copied.';
				} catch {
					status.textContent = 'Link is in the address bar.';
				}
			});
		}

		// Fetch and compile once the REPL comes into view, so Run is instant.
		new IntersectionObserver((entries, obs) => {
			if (entries.some((e) => e.isIntersecting)) {
				obs.disconnect();
				warm();
			}
		}).observe(root);
	}

	document.querySelectorAll<HTMLElement>('.tr-repl').forEach(setup);
</script>
