thread_bindings-true-[c(1),at_exit]
thread_nested-true-[c2,c1]
thread_det-true-[det]
thread_fail-false-[failed]
thread_exit-exited(bye)-[exited]
thread_backtracking-true-[p,q]
thread_throw-exception(oops)-[older]
thread_two_throws-exception(second)-[]
