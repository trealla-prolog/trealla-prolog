can_be(list(integer),[a,b]): type_error(type,list(integer))
can_be(list(A),[a]): type_error(type,list(A))
can_be([a,t,o,m],a): type_error(type,[a,t,o,m])
can_be(list,[a|A]): true
can_be(list,[A|B]): true
can_be(list,[a,b]): true
can_be(list,[a|b]): type_error(list,[a|b])
can_be(atom,[a,b]): type_error(atom,[a,b])
can_be(atomic,[a,b]): type_error(atomic,[a,b])
can_be(atom,a): true
can_be(chars,[a,b]): true
can_be(chars,[a,b,c]): true
can_be(chars,[a,A|B]): true
can_be(chars,[a,1]): type_error(character,1)
can_be(chars,a): type_error(list,a)
can_be(chars,[1|2]): type_error(list,[1|2])
can_be(var,A): true
can_be(var,a): uninstantiation_error(a)
can_be(ground,f(A)): true
can_be(nonvar,a): true
can_be(acyclic,cyclic): domain_error/2
must_be([a,t,o,m],a): type_error(type,[a,t,o,m])
